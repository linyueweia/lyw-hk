{
  "model": {
    "id": "hlink,h88k",
    "name": "HINLINK H88K V3"
  },
  "led": [
    {
      "name": "POWER-LED",
      "sysfs": "blue:net",
      "trigger": "default-on"
    },
    {
      "name": "DISK-LED",
      "sysfs": "amber:sata",
      "trigger": "disk-activity"
    }
  ],
  "fan": [
    {
      "name": "fan0",
      "tsysfs": "/sys/devices/virtual/thermal/thermal_zone0/temp",
      "fsysfs": "/sys/devices/virtual/thermal/cooling_device0/cur_state",
      "start_speed": 1,
      "max_speed": 4,
      "start_temp": 45,
      "temp_div": 1000
    }
  ]
}
